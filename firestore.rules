rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User root document and all personal subcollections
    // (sessions, subjects, tasks, dailyReviews, pyqs, answerWriting, revision)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
